  "passives": [
    {
      "id": "spring_rite_of_the_chosen_one",
      "name": "Rito primaverile della Prescelta",
      "description": "Quando Odette evoca la sua <b><span style=\"color:#FFD780FF\">Controfigura danzante solista</span></b>, ottiene anche 4 accumuli di <b><span style=\"color:#FFD780FF\">Splendore stupefacente</span></b>.",
      "level": 1
    },
    {
      "id": "pathetique_of_pateticheskaya",
      "name": "Patetica di Pateticheskaya",
      "description": "I DAN da Barlume astrale aumentano di un 1,5% aggiuntivo dei DAN originali per ogni 100 di ATT di Odette al di sopra di 1.000. In questo modo può infliggere fino a un 30% di DAN aggiuntivi.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_dance_of_aurore",
      "name": "Giubileo astrale: Danza dell'aurora",
      "description": "Odette entra nello stato di <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span> quando si trova all'interno di un <b><span style=\"color:#FFD780FF\">Campo astropolare</span></b> o nello stato di <span style=\"color:#FFD780FF\">Splendore: Turbinio astrale</span> per 8 s dopo che un membro vicino del gruppo ha innescato una reazione di Turbinio astrale.<br/>Quando un membro del gruppo innesca una reazione di Superconduzione o Turbinio di Cryo, quest'ultima diventa una reazione di Astroconduzione o di Turbinio astrale, e i DAN base di tale reazione aumentano di un ulteriore 0,7% per ogni 100 di ATT di Odette. In questo modo è possibile ottenere fino a un 14% di aumento massimo.",
      "level": 0
    },
    {
      "id": "echo_of_winter_daydreams",
      "name": "Eco di sogni a occhi aperti invernali",
      "description": "Mostra sulla minimappa la posizione delle <span style=\"color:#FFD780FF\">specialità locali di Snezhnaya</span>.<br/>Esercitarsi nella danza nel tempo libero potrebbe persino attivare altri effetti...",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1501,
      "id": "on_this_danceless_morn_she_gazes_at_her_reflection",
      "name": "\"In questo mattino senza danza, ella osserva il suo riflesso\"",
      "description": "Dopo aver sprigionato l'abilità elementale speciale <b><span style=\"color:#FFD780FF\">Adagio: Gran finale dell'alba</span></b>, Odette infligge un'iterazione di <span style=\"color:#99FFFFFF\">DAN da Cryo ad area</span> aggiuntiva agli avversari vicini al termine del duetto. La natura di tali DAN varia in base ai seguenti criteri.<br/>· Nello stato di <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span> o in nessuno stato di Splendore, Odette infligge DAN da Astroconduzione pari a un 300% del suo ATT.<br/>· Nello stato di <span style=\"color:#FFD780FF\">Splendore: Turbinio astrale</span>, Odette infligge DAN da Turbinio astrale pari a un 450% del suo ATT.<br/><br/>Inoltre, il talento d'ascensione \"Rito primaverile della Prescelta\" riceve un potenziamento: ora, quando la <b><span style=\"color:#FFD780FF\">Controfigura danzante solista</span></b> viene evocata, Odette ottiene anche 2 accumuli di <b><span style=\"color:#FFD780FF\">Splendore stupefacente</span></b> e, quando non è in campo, la velocità di riduzione di <span style=\"color:#FFD780FF\">Splendore stupefacente</span> aumenta a 2 accumuli al secondo.",
      "level": 1
    },
    {
      "_id": 1502,
      "id": "i_must_see_the_snow_swans_unseen_dream_for_myself_she_thought",
      "name": "\"'Devo ammirare il sogno invisibile del cigno delle nevi coi miei occhi', pensò\"",
      "description": "Il talento d'ascensione \"Rito primaverile della Prescelta\" viene potenziato come segue: ogni accumulo di <b><span style=\"color:#FFD780FF\">Splendore stupefacente</span></b> attivo aumenta anche l'ATT del personaggio di un 7%.<br/>Inoltre, se Odette si trova in uno stato di <b><span style=\"color:#FFD780FF\">Splendore: Barlume astrale</span></b> quando è presente una <b><span style=\"color:#FFD780FF\">Controfigura danzante solista</span></b> in campo, anche la rispettiva RES elementale degli avversari vicini alla <span style=\"color:#FFD780FF\">Controfigura danzante</span> si riduce di un 20%.<br/>· <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span>: <span style=\"color:#99FFFFFF\">Cryo</span> ed <span style=\"color:#FFACFFFF\">Electro</span>.<br/>· <span style=\"color:#FFD780FF\">Splendore: Turbinio astrale</span>: <span style=\"color:#99FFFFFF\">Cryo</span> e <span style=\"color:#80FFD7FF\">Anemo</span>.",
      "level": 2
    },
    {
      "_id": 1503,
      "id": "ill_chase_the_shouting_wind_along_climbing_alone_as_i_go",
      "name": "\"Inseguirò il vento urlante, arrampicandomi sola lungo il cammino\"",
      "description": "Aumenta di 3 il livello di <color=#FFD780FF><b>Adagio: Danza della Notte fantasma</b></color>.<br/>Il livello di potenziamento massimo è 15.",
      "level": 3
    },
    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "\"Su, su, nel lungo, delirante, ardente blu\"",
      "description": "Il Tripudio elementale <span style=\"color:#FFD780FF\">Presto: Ultimo atto dell'Uccello azzurro</span> viene potenziato come segue: quando Odette ottiene <span style=\"color:#FFD780FF\">Sogno del cigno delle nevi</span>, i DAN da reazione di Barlume astrale inflitti dagli altri membri vicini del gruppo aumentano di un 50% degli effetti di <span style=\"color:#FFD780FF\">Sogno del cigno delle nevi</span>.<br/><br/>Inoltre, quando un membro del gruppo infligge DAN da reazione di Barlume astrale a un avversario, anche Odette sferra un attacco coordinato, infliggendo un'iterazione di <span style=\"color:#99FFFFFF\">DAN da Cryo ad area</span>. Questo effetto può attivarsi una volta ogni 3,5 s. La natura di tali DAN varia in base ai seguenti criteri.<br/>· Nello stato di <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span> o in nessuno stato di Splendore, Odette infligge DAN da reazione di Astroconduzione pari a un 66% del suo ATT.<br/>· Nello stato di <span style=\"color:#FFD780FF\">Splendore: Turbinio astrale</span>, Odette infligge DAN da reazione di Turbinio astrale pari a un 99% del suo ATT.",
      "level": 4
    },
    {
      "_id": 1505,
      "id": "oh_i_have_slipped_the_surly_bonds_of_earth",
      "name": "\"Ah! Sono libera dai torvi legami della terra\"",
      "description": "Aumenta di 3 il livello di <color=#FFD780FF><b>Presto: Ultimo atto dell'Uccello azzurro</b> </color>.<br/>Il livello di potenziamento massimo è 15.",
      "level": 5
    },
    {
      "_id": 1506,
      "id": "put_out_my_hand_and_touched_the_face_of_the_divine",
      "name": "\"Ho proteso la mano e sfiorato il volto del divino\"",
      "description": "Il talento d'ascensione \"Rito primaverile della Prescelta\" viene potenziato come segue: quando Odette conferisce <b><span style=\"color:#FFD780FF\">Splendore stupefacente</span></b> a tutti i membri del gruppo vicini, i suoi accumuli di Splendore stupefacente non diminuiscono più.<br/>Inoltre, i DAN da Barlume astrale inflitti agli avversari dai personaggi sotto l'effetto di <span style=\"color:#FFD780FF\">Splendore stupefacente</span> vengono <b><span style=\"color:#FFD780FF\">innalzati</span></b> di un 25%, e i DAN da Barlume astrale inflitti da Odette vengono innalzati di un ulteriore 20%.",
      "level": 6
    }
  ],
