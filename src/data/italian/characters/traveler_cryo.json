  "passives": [
    {
      "id": "everkeen_frost",
      "name": "Gelo perpetuo",
      "description": "Nello stato di <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span>, quando una <span style=\"color:#FFD780FF\">Stella perforagelo</span> è in campo, i DAN di attacchi normali, caricati e in picchiata del viaggiatore vengono convertiti in <span style=\"color:#99FFFFFF\">DAN da Cryo</span> che non possono essere influenzati da altre infusioni elementali. In più, i DAN inflitti aumentano di un 80% dell'ATT del viaggiatore.",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "Ghiaccio lucente",
      "description": "La maestria elementale del viaggiatore aumenta di un 8% del suo ATT. L'incremento massimo ottenibile in questo modo è di 160.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "Giubileo astrale: Specchio del gelo illusorio",
      "description": "Il viaggiatore entra nello stato di <b><span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span></b> quando si trova all'interno di un <span style=\"color:#FFD780FF\">Campo astropolare</span> o nello stato di <span style=\"color:#FFD780FF\">Splendore: Turbinio astrale</span> per 8 s dopo che un membro vicino del gruppo ha innescato una reazione di Turbinio astrale.<br/>Quando un membro del gruppo innesca una reazione di Superconduzione o Turbinio di Cryo, quest'ultima diventa una reazione di Astroconduzione o di Turbinio astrale, e i DAN base di tale reazione aumentano di un ulteriore 0,35% per ogni 100 di ATT del viaggiatore. In questo modo è possibile ottenere fino a un 7% di aumento massimo.",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 81,
