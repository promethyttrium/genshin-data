  "passives": [
    {
      "id": "awakened_by_the_baying_hounds",
      "name": "Risveglio dei segugi ululanti",
      "description": "Quando <b><span style=\"color:#FFD780FF\">Tugarin</span></b> attacca, ripristina anche i PS dei membri attivi del gruppo di una quantità pari a un 120% dell'ATT di Alyosha.",
      "level": 1
    },
    {
      "id": "suffer_the_winter_wheat_will",
      "name": "L'inverno, e la sofferenza del frumento",
      "description": "Aumenta i DAN inflitti da Alyosha con la sua abilità elementale e il suo Tripudio elementale di uno 0,35% per ogni 1% della sua ricarica d'energia. In questo modo è possibile ottenere fino a un 70% di aumento massimo.",
      "level": 4
    },
    {
      "id": "into_the_fray",
      "name": "Nella mischia",
      "description": "Alyosha entra nello stato di <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span> quando si trova all'interno di un <b><span style=\"color:#FFD780FF\">Campo astropolare</span></b>.<br/>Nello stato di <span style=\"color:#FFD780FF\">Splendore: Astroconduzione</span>, l'effetto <span style=\"color:#FFD780FF\">Precisione del cacciatore</span> ottenuto all'attivazione del <b><span style=\"color:#FFD780FF\">Marchio del cacciatore</span></b> aumenta di un 20% anche i DAN da Astroconduzione inflitti dal personaggio quando è in campo.",
      "level": 0
    },
    {
      "id": "treetop_watch",
      "name": "Vedetta arborea",
      "description": "Mostra sulla minimappa la posizione delle <span style=\"color:#FFD780FF\">risorse uniche di Snezhnaya</span> vicine.",
      "level": 0
    }
  ],
