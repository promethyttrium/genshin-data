  "passives": [
    {
      "id": "spring_rite_of_the_chosen_one",
      "name": "Весеннее жертвоприношение избранницы",
      "description": "Когда Одетта призывает <b><span style=\"color:#FFD780FF\">Отражение соло</span></b>, она также получает 4 уровня <b><span style=\"color:#FFD780FF\">Яркого великолепия</span></b>.",
      "level": 1
    },
    {
      "id": "pathetique_of_pateticheskaya",
      "name": "Элегия чистого сердца",
      "description": "За каждые 100 ед. силы атаки Одетты свыше 1000 ед. урон её реакций Звёздного блеска дополнительно повышается на 1,5% от исходного. Максимальное повышение, которое можно получить таким образом, составляет 30%.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_dance_of_aurore",
      "name": "Танец серебряной зари",
      "description": "Когда Одетта пребывает в <b><span style=\"color:#FFD780FF\">Пределе путеводной звезды</span></b> или на 8 сек. после того как персонажи отряда поблизости активируют Звёздное рассеивание, она входит в состояние <span style=\"color:#FFD780FF\">Сияние - Звёздный проводник</span> или <span style=\"color:#FFD780FF\">Сияние - Звёздное рассеивание</span> соответственно.<br/>Когда персонажи отряда активируют реакции Сверхпроводник или Крио рассеивание, они превращаются в Звёздный проводник или Звёздное рассеивание, а базовый урон этих реакций увеличивается на 0,7% за каждые 100 ед. силы атаки Одетты. Максимальное увеличение урона, которое можно получить таким образом, составляет 14%.",
      "level": 0
    },
    {
      "id": "echo_of_winter_daydreams",
      "name": "Отголоски зимних снов",
      "description": "Отмечает <span style=\"color:#FFD780FF\">диковинки Снежной</span> на мини-карте.<br/>Занятия танцами в свободное время могут активировать и другие эффекты...",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1501,
      "id": "on_this_danceless_morn_she_gazes_at_her_reflection",
      "name": "«В то утро без танца она смотрела на своё отражение»",
      "description": "После применения особого элементального навыка <b><span style=\"color:#FFD780FF\">Адажио: Рассветная кода</span></b> в конце танцевального дуэта Одетта дополнительно наносит врагам поблизости однократный <span style=\"color:#99FFFFFF\">Крио урон по площади</span>. Такой урон считается:<br/>· <span style=\"color:#FFD780FF\">Сияние - Звёздный проводник</span> или вне состояния Сияния: уроном реакции Звёздный проводник, равным 300% от силы атаки Одетты.<br/>· <span style=\"color:#FFD780FF\">Сияние - Звёздное рассеивание</span>: уроном реакции Звёздное рассеивание, равным 450% от силы атаки Одетты.<br/><br/>Кроме того, талант возвышения Весеннее жертвоприношение избранницы получает усиление: когда Одетта призывает <b><span style=\"color:#FFD780FF\">Отражение соло</span></b>, она дополнительно получает 2 уровня <b><span style=\"color:#FFD780FF\">Яркого великолепия</span></b>. Когда Одетта не на поле боя, потеря уровней <span style=\"color:#FFD780FF\">Яркого великолепия</span> ускорена до 2 в сек.",
      "level": 1
    },
    {
      "_id": 1502,
      "id": "i_must_see_the_snow_swans_unseen_dream_for_myself_she_thought",
      "name": "«Она захотела увидеть сон, невиданный снежным лебедем»",
      "description": "Талант возвышения Весеннее жертвоприношение избранницы получает усиление: сила атаки персонажа увеличивается на 7% за каждый уровень <b><span style=\"color:#FFD780FF\">Яркого великолепия</span></b>.<br/>Кроме того, когда <b><span style=\"color:#FFD780FF\">Отражение соло</span></b> на поле, а Одетта находится в состоянии <b><span style=\"color:#FFD780FF\">Сияние - Звёздный блеск</span></b>, то сопротивление соответствующему элементу врагов рядом с <span style=\"color:#FFD780FF\">Отражением соло</span> снижается на 20%:<br/>· <span style=\"color:#FFD780FF\">Сияние - Звёздный проводник</span>: <span style=\"color:#99FFFFFF\">Крио</span>, <span style=\"color:#FFACFFFF\">Электро</span>.<br/>· <span style=\"color:#FFD780FF\">Сияние - Звёздное рассеивание</span>: <span style=\"color:#99FFFFFF\">Крио</span>, <span style=\"color:#80FFD7FF\">Анемо</span>.",
      "level": 2
    },
    {
      "_id": 1503,
      "id": "ill_chase_the_shouting_wind_along_climbing_alone_as_i_go",
      "name": "«В погоне за воющим ветром одна я ввысь устремлюсь»",
      "description": "Увеличивает уровень навыка <color=#FFD780FF><b>Адажио: Призрачные танцоры ночи</b></color> на 3.<br/>Макс. уровень: 15",
      "level": 3
    },
    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "«Ввысь, падая в зыбкое, пылающее синее небо»",
      "description": "Взрыв стихии <span style=\"color:#FFD780FF\">Престо: Финал сизых крыльев</span> получает усиление: когда Одетта наделяется <span style=\"color:#FFD780FF\">Сновидением снежного лебедя</span>, урон реакций Звёздного блеска других персонажей отряда поблизости также повышается на 50% от эффектов <span style=\"color:#FFD780FF\">Сновидения снежного лебедя</span>.<br/><br/>Кроме того, когда персонажи отряда наносят врагу урон реакций Звёздного блеска, Одетта проводит совместную атаку, которая наносит однократный <span style=\"color:#99FFFFFF\">Крио урон по площади</span>. Такой урон может возникнуть один раз в 3,5 сек. и является:<br/>· <span style=\"color:#FFD780FF\">Сияние - Звёздный проводник</span> или вне состояния Сияния: уроном реакции Звёздный проводник, равным 66% от силы атаки Одетты.<br/>·<span style=\"color:#FFD780FF\">Сияние - Звёздное рассеивание</span>: уроном реакции Звёздное рассеивание, равным 99% от силы атаки Одетты.",
      "level": 4
    },
    {
      "_id": 1505,
      "id": "oh_i_have_slipped_the_surly_bonds_of_earth",
      "name": "«Взгляни - я простилась с мирскими муками»",
      "description": "Увеличивает уровень навыка <color=#FFD780FF><b>Престо: Финал сизых крыльев</b></color> на 3.<br/>Макс. уровень: 15",
      "level": 5
    },
    {
      "_id": 1506,
      "id": "put_out_my_hand_and_touched_the_face_of_the_divine",
      "name": "«Протяни руку и коснись вечного лика небосвода»",
      "description": "Талант возвышения Весеннее жертвоприношение избранницы получает усиление: когда все члены отряда поблизости получают <b><span style=\"color:#FFD780FF\">Яркое великолепие</span></b> Одетты, она больше не теряет собственное Яркое великолепие.<br/>Кроме того, наносимый врагам урон реакций Звёздного блеска персонажей под воздействием <span style=\"color:#FFD780FF\">Яркого великолепия</span> <b><span style=\"color:#FFD780FF\">возвышается</span></b> на 25%, а урон реакций Звёздного блеска Одетты дополнительно возвышается на 20%.",
      "level": 6
    }
