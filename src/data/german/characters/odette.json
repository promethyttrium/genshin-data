    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "„Aufwärts, hinab in den träumerischen, lodernden blauen Himmel“",
      "description": "Verstärkt die Spezialfähigkeit <span style=\"color:#FFD780FF\">Schneller Tanz – Federntraum</span>: Erhöht, wenn Odette <span style=\"color:#FFD780FF\">Traum der Schneeschwänin</span> erhält, den von Truppenmitgliedern in der Nähe durch Stellarfunkeln-Reaktionen verursachten Schaden um 50 % des Effekts <span style=\"color:#FFD780FF\">Traum der Schneeschwänin</span>.<br/><br/>Wenn ein Truppenmitglied einem Gegner Schaden mit der Reaktion Stellarfunkeln zufügt, führt Odette einen abgestimmten Angriff auf den Gegner aus, der diesem einmalig <span style=\"color:#99FFFFFF\">Kryo-Flächenschaden</span> zufügt, 3,5 s Abklingzeit. Hierdurch verursachter Schaden gilt als:<br/>· <span style=\"color:#FFD780FF\">Leuchten – Stellar-Supraleiter</span>, oder, wenn nicht im Leuchten-Zustand: Stellar-Supraleiter-Reaktionsschaden in Höhe von 66 % von Odettes ANG.<br/>· <span style=\"color:#FFD780FF\">Leuchten – Stellar-Verwirbelung</span>: Stellar-Verwirbelung-Reaktionsschaden in Höhe von 99 % von Odettes ANG.",
      "level": 4
    },
    {
      "_id": 1505,
      "id": "oh_i_have_slipped_the_surly_bonds_of_earth",
      "name": "„Seht, denn ich habe mich vom irdischen Leiden verabschiedet“",
      "description": "Erhöht die Stufe der Spezialfähigkeit <color=#FFD780FF><b>Schneller Tanz – Federntraum</b> </color> um 3.<br/>Höchststufe 15.",
      "level": 5
    },
    {
      "_id": 1506,
      "id": "put_out_my_hand_and_touched_the_face_of_the_divine",
      "name": "„Strecke deine Hand aus und berühre das ewige Antlitz des Himmels“",
      "description": "Verstärkt das Aufstiegstalent „Frühling der Auserwählten“: Reduziert, wenn Odette allen Truppenmitgliedern in der Nähe <b><span style=\"color:#FFD780FF\">Farbenpracht</span></b> verleiht, ihre eigene Farbenpracht nicht mehr.<br/>Erhöht zudem den Schaden durch Stellarfunkeln-Reaktionen, den Figuren unter dem Einfluss von <span style=\"color:#FFD780FF\">Farbenpracht</span> Gegnern zufügen, um <b><span style=\"color:#FFD780FF\">25 %</span></b>. Steigert außerdem den Schaden durch Stellarfunkeln-Reaktionen, den Odette Gegnern zufügt, um weitere 20 %.",
      "level": 6
    }
