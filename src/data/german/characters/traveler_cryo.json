  "passives": [
    {
      "id": "everkeen_frost",
      "name": "Selbstschärfender Frost",
      "description": "<span style=\"color:#FFD780FF\">Leuchten – Stellar-Supraleiter</span>: Wandelt während der Wirkungsdauer von <span style=\"color:#FFD780FF\">Frostdurchbohrender Stern</span> den durch Standardangriffe, heftige Schläge und Angriffe aus dem Fall des Reisenden verursachten Schaden in <span style=\"color:#99FFFFFF\">Kryo-Schaden</span> um, der nicht durch andere Elemente überdeckt werden kann. Erhöht zudem den verursachten Schaden um 80 % des ANG des Reisenden.",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "Klares Eis",
      "description": "Erhöht die Elementarkunde des Reisenden um 8 % seines ANG. Auf diese Weise kann die Elementarkunde des Reisenden um maximal 160 Punkte erhöht werden.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "Sternensegnung – Wandelnder Eisspiegel",
      "description": "Versetzt den Reisenden, wenn er sich im <b><span style=\"color:#FFD780FF\">Sternglanzfeld</span></b> befindet oder ein Truppenmitglied in der Nähe die Reaktion Stellar-Verwirbelung auslöst, innerhalb von 8 s in den Zustand <span style=\"color:#FFD780FF\">Leuchten – Stellar-Supraleiter</span>/<span style=\"color:#FFD780FF\">Leuchten – Stellar-Verwirbelung</span>.<br/>Wandelt, wenn ein Truppenmitglied die Reaktion Supraleiter/Kryo-Verwirbelung auslöst, diese stattdessen in die Reaktion Stellar-Supraleiter/Stellar-Verwirbelung um und erhöht den Basis-Schaden der oben genannten Reaktionen von Truppenmitgliedern basierend auf dem ANG des Reisenden: Erhöht den Basis-SCH der oben genannten Reaktionen pro 100 Punkte um 0,35 %. Auf diese Weise kann der Schaden um bis zu 7 % erhöht werden.",
      "level": 0
    }
  ],
