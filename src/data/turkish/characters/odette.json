  "constellations": [
    {
      "_id": 1501,
      "id": "on_this_danceless_morn_she_gazes_at_her_reflection",
      "name": "\"Danssız Bir Sabahta Baktı Yansımasına\"",
      "description": "<b><span style=\"color:#FFD780FF\">Yavaş Tempo: Şafakla Gelen Son</span></b> özel Element Becerisi kullanıldığında, Odette dans düetini bitirdiğinde yakındaki düşmanlara ek bir <span style=\"color:#99FFFFFF\">Buz Alan Hasarı</span> verir. Bu Hasar:<br/><span style=\"color:#FFD780FF\">Işıltı: Yıldız İletimi</span> durumundayken veya bir Işıltı durumunda değilken Odette'in Saldırısının %300'ü oranında Yıldız İletimi Tepkimesi Hasarı olur;<br/><span style=\"color:#FFD780FF\">Işıltı: Yıldız Girdabı</span> durumundayken ise Odette'in Saldırısının %450'si oranında Yıldız Girdabı Tepkimesi Hasarı olur.<br/><br/>Ayrıca \"Seçilmiş Kişinin Bahar Ayini\" Yükseltme Yeteneği de gelişir: Artık <b><span style=\"color:#FFD780FF\">Solo Dans Gölgesi</span></b> çağrıldığında Odette ek 2 kademe <b><span style=\"color:#FFD780FF\">Mucizevi İhtişam</span></b> kazanır ve alanda değilken <span style=\"color:#FFD780FF\">Mucizevi İhtişam</span> kademelerini kaybetme hızı saniyede 2 kademeye çıkar.",
      "level": 1
    },
    {
      "_id": 1502,
      "id": "i_must_see_the_snow_swans_unseen_dream_for_myself_she_thought",
      "name": "\"Kar Kuğusunun Görülmeyen Rüyasını Bizzat Görmeliyim Diye Düşündü\"",
      "description": "\"Seçilmiş Kişinin Bahar Ayini\" Yükseltme Yeteneği gelişir: Her etkin <b><span style=\"color:#FFD780FF\">Mucizevi İhtişam</span></b> kademesi ek olarak karakterin Saldırısını %7 artırır.<br/>Ayrıca eğer alanda bir <b><span style=\"color:#FFD780FF\">Solo Dans Gölgesi</span></b> varken Odette <b><span style=\"color:#FFD780FF\">Işıltı: Yıldız Parıltısı</span></b> durumundaysa <span style=\"color:#FFD780FF\">Dans Gölgesinin</span> yakınındaki düşmanların ilgili Element Direnci %20 düşer.<br/>·<span style=\"color:#FFD780FF\">Işıltı: Yıldız İletimi</span>: <span style=\"color:#99FFFFFF\">Buz</span> ve <span style=\"color:#FFACFFFF\">Elektrik</span> Dirençleri düşer.<br/>·<span style=\"color:#FFD780FF\">Işıltı: Yıldız Girdabı</span>: <span style=\"color:#99FFFFFF\">Buz</span> ve <span style=\"color:#80FFD7FF\">Rüzgar</span> Dirençleri düşer.",
      "level": 2
    },
    {
      "_id": 1503,
      "id": "ill_chase_the_shouting_wind_along_climbing_alone_as_i_go",
      "name": "\"Haykıran Rüzgarın Peşine Düşeceğim, Yalnız Tırmanacağım Yükseklere\"",
      "description": "<color=#FFD780FF><b>Yavaş Tempo: Hayalet Gece Dansçıları</b></color> seviyesini 3 artırır.<br/>Maksimum yükseltme seviyesi 15'tir.",
