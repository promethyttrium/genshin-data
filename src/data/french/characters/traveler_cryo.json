  "passives": [
    {
      "id": "everkeen_frost",
      "name": "Gelée toujours vive",
      "description": "<span style=\"color:#FFD780FF\">Radiance « Astroconduction »</span> : Pendant la durée d'une <span style=\"color:#FFD780FF\">étoile perce-givre</span>, les attaques normales, chargées et plongeantes du voyageur sont converties pour infliger des <span style=\"color:#99FFFFFF\">DGT Cryo</span> ne pouvant pas être enchantés, et les DGT infligés augmentent d'une valeur équivalant à 80 % de son ATQ.",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "Glace lucide",
      "description": "La maîtrise élémentaire du voyageur augmente d'une valeur équivalant à 8 % de son ATQ, la maîtrise élémentaire pouvant être augmentée d'un maximum de 160 pts de cette manière.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "Jubilé stellaire : Miroir de givre illusoire",
      "description": "Le voyageur passe en <span style=\"color:#FFD780FF\">radiance « Astroconduction »</span> ou en <span style=\"color:#FFD780FF\">radiance « Astrodispersion »</span> pendant 8 s lorsqu'il est dans une <b><span style=\"color:#FFD780FF\">étendue polaris</span></b> ou lorsqu'un personnage de l'équipe a déclenché une réaction d'Astrodispersion à proximité, respectivement.<br/>Lorsqu'un personnage de l'équipe déclenche une réaction de Supraconduction ou de Dispersion Cryo, elle est convertie en réaction d'Astroconduction ou d'Astrodispersion, dont les DGT de base augmentent selon l'ATQ du voyageur : chaque tranche de 100 pts d'ATQ augmente les DGT de base de ces réactions de 0,35 %, les DGT pouvant être augmentés d'un maximum de 7 % de cette manière.",
      "level": 0
    }
  ],
