  "passives": [
    {
      "id": "awakened_by_the_baying_hounds",
      "name": "Awakened by the Baying Hounds",
      "description": "Saat <b><span style=\"color:#FFD780FF\">Tugarin</span></b> menyerang, ia juga akan memulihkan HP Karakter aktif party di sekitar sebesar 120% dari ATK Alyosha.",
      "level": 1
    },
    {
      "id": "suffer_the_winter_wheat_will",
      "name": "Suffer the Winter Wheat Will",
      "description": "Meningkatkan DMG yang diakibatkan oleh Elemental Skill dan Elemental Burst Alyosha berdasarkan Energy Recharge Alyosha: Setiap 1% Energy Recharge akan meningkatkan DMG ini sebesar 0,35% hingga maksimum 70%.",
      "level": 4
    },
    {
      "id": "into_the_fray",
      "name": "Into the Fray",
      "description": "Alyosha akan memasuki status <span style=\"color:#FFD780FF\">Radiance: Stellar-Conduct</span> saat berada di dalam <b><span style=\"color:#FFD780FF\">Polestar Field</span></b>.<br/><span style=\"color:#FFD780FF\">Radiance: Stellar-Conduct</span>: Efek <span style=\"color:#FFD780FF\">Hunter's Precision</span> yang diperoleh saat mengaktifkan <b><span style=\"color:#FFD780FF\">Hunter's Mark</span></b> juga akan meningkatkan 20% DMG reaksi Stellar-Conduct yang diakibatkan Karakter yang berada di medan pertempuran.",
      "level": 0
    },
    {
      "id": "treetop_watch",
      "name": "Treetop Watch",
      "description": "Memperlihatkan lokasi <span style=\"color:#FFD780FF\">produk khas Snezhnaya</span> di sekitar pada peta kecil.",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1481,
      "id": "frostvale_thunderclap",
      "name": "Frostvale Thunderclap",
      "description": "Setelah Karakter party di sekitar memicu <span style=\"color:#FFACFFFF\">reaksi terkait Electro</span> terhadap musuh, akan memulihkan 15 poin Energy untuk Alyosha. Efek ini dapat terpicu maksimal sekali setiap 18 detik.",
      "level": 1
    },
    {
      "_id": 1482,
      "id": "howl_from_afar",
      "name": "Howl From Afar",
      "description": "Durasi Elemental Burst <span style=\"color:#FFD780FF\">Hunter's Advance</span> diperpanjang 6 detik.<br/>Selain itu, sebelum setiap kali <b><span style=\"color:#FFD780FF\">Tugarin</span></b> menyerang musuh, ia juga akan memberikan efek <b><span style=\"color:#FFD780FF\">Hunter's Mark</span></b> terhadap satu target. Efek ini tidak akan mengaktifkan <span style=\"color:#FFD780FF\">Hunter's Mark</span> yang sudah ada.",
      "level": 2
    },
    {
