    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "\"Up, Up the Long, Delirious, Burning Blue\"",
      "description": "Elemental Burst <span style=\"color:#FFD780FF\">Presto: Bluebird Finale</span> diperkuat: Saat Odette mendapatkan efek <span style=\"color:#FFD780FF\">Snow Swan's Dream</span>, DMG reaksi Stellar Glimmer yang diakibatkan Karakter lain dalam party di sekitar juga akan meningkat sebesar 50% dari efek <span style=\"color:#FFD780FF\">Snow Swan's Dream</span>.<br/><br/>Selain itu, saat serangan Karakter dalam party mengakibatkan DMG reaksi Stellar Glimmer terhadap musuh, Odette juga akan melancarkan satu kali serangan terkoordinasi terhadap musuh tersebut, mengakibatkan satu kali <span style=\"color:#99FFFFFF\">Cryo DMG Area</span>. Efek ini dapat terpicu sekali setiap 3,5 detik dan dianggap sebagai:<br/>·<span style=\"color:#FFD780FF\">Radiance: Stellar-Conduct</span> atau saat tidak berada dalam status Radiance: DMG reaksi Stellar-Conduct sebesar 66% ATK Odette.<br/>·<span style=\"color:#FFD780FF\">Radiance: Stellar Swirl</span>: DMG reaksi Stellar Swirl sebesar 99% ATK Odette.",
      "level": 4
    },
    {
      "_id": 1505,
      "id": "oh_i_have_slipped_the_surly_bonds_of_earth",
      "name": "\"Oh! I Have Slipped the Surly Bonds of Earth\"",
      "description": "Meningkatkan 3 level Elemental Burst <color=#FFD780FF><b>Presto: Bluebird Finale</b> </color>.<br/>Maksimum: Lv. 15.",
      "level": 5
    },
    {
      "_id": 1506,
      "id": "put_out_my_hand_and_touched_the_face_of_the_divine",
      "name": "\"Put Out My Hand, and Touched the Face of the Divine\"",
      "description": "Talenta Ascension \"Spring Rite of the Chosen One\" diperkuat: Saat Odette memberikan <b><span style=\"color:#FFD780FF\">Marvelous Splendor</span></b> kepada semua Karakter party di sekitar, maka Marvelous Splendor milik Odette sendiri tidak akan berkurang lagi.<br/>Selain itu, untuk Karakter yang berada di bawah pengaruh <span style=\"color:#FFD780FF\">Marvelous Splendor</span>, DMG reaksi Stellar Glimmer yang diakibatkannya terhadap musuh akan <b><span style=\"color:#FFD780FF\">bertumbuh</span></b> 25%, dan DMG reaksi Stellar Glimmer yang diakibatkan Odette terhadap musuh akan bertumbuh lagi sebesar 20%.",
      "level": 6
    }
