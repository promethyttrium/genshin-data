  "passives": [
    {
      "id": "everkeen_frost",
      "name": "Ever-Keen Frost",
      "description": "<span style=\"color:#FFD780FF\">Radiance: Stellar-Conduct</span>: Selama durasi <span style=\"color:#FFD780FF\">Frostpierce Star</span>, Normal Attack, Charged Attack, dan Plunging Attack Pengembara akan dikonversi menjadi <span style=\"color:#99FFFFFF\">Cryo DMG</span> yang tidak bisa ditimpa Elemental Infusion lainnya, dan DMG yang diakibatkan meningkat sebesar 80% dari ATK Pengembara.",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "Lucent Ice",
      "description": "Elemental Mastery Pengembara meningkat sebesar 8% ATK-nya. Peningkatan Elemental Mastery yang bisa diperoleh Pengembara dengan cara ini adalah maksimum 160 poin.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "Stellar Jubilee: Illusory Frostmirror",
      "description": "Pengembara akan memasuki status <span style=\"color:#FFD780FF\">Radiance: Stellar-Conduct</span> saat berada di dalam <b><span style=\"color:#FFD780FF\">Polestar Field</span></b> atau <span style=\"color:#FFD780FF\">Radiance: Stellar Swirl</span> selama 8 detik setelah Karakter dalam party di sekitar memicu reaksi Stellar Swirl.<br/>Ketika Karakter dalam party memicu reaksi Superconduct/Cryo Swirl, reaksi ini akan berubah menjadi reaksi Stellar-Conduct/Stellar Swirl dan DMG dasar dari reaksi yang disebutkan di atas akan meningkat berdasarkan ATK Pengembara: Setiap 100 poin ATK akan meningkatkan DMG dasar reaksinya sebesar 0,35%. Peningkatan DMG maksimum yang bisa didapatkan dengan cara ini adalah 7%.",
      "level": 0
    }
  ],
