  "passives": [
    {
      "id": "everkeen_frost",
      "name": "自銳的凜冰",
      "description": "<span style=\"color:#FFD780FF\">輝映·星超導</span>：<span style=\"color:#FFD780FF\">栗烈寒星</span>存在期間，旅行者的普通攻擊、重擊、下落攻擊將轉為造成無法被附魔覆蓋的<span style=\"color:#99FFFFFF\">冰元素傷害</span>，且造成的傷害提升，提升值相當於旅行者攻擊力的80%。",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "通明的冽冰",
      "description": "旅行者的元素精通提升，提升值相當於旅行者攻擊力的8%。依此方式，至多使旅行者的元素精通提升160點。",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "星耀祝禮·幻變冰鏡",
      "description": "處於<b><span style=\"color:#FFD780FF\">極星輝域</span></b>中時/隊伍中的角色在附近觸發星擴散反應後的8秒內，旅行者將分別進入<span style=\"color:#FFD780FF\">輝映·星超導</span>/<span style=\"color:#FFD780FF\">輝映·星擴散</span>狀態。<br/>隊伍中的角色觸發超導/冰元素擴散反應時，將轉為觸發星超導/星擴散反應，且基於旅行者的攻擊力，提升隊伍中角色造成的上述反應的基礎傷害：每100點攻擊力都將提升0.35%上述反應的基礎傷害，至多依此方式提升7%傷害。",
      "level": 0
    }
  ],
