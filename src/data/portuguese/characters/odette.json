  "passives": [
    {
      "id": "spring_rite_of_the_chosen_one",
      "name": "Primavera do Escolhido",
      "description": "Quando Odette invocar <b><span style=\"color:#FFD780FF\">Sombra Dançarina</span></b>, obtém 4 acúmulos de <b><span style=\"color:#FFD780FF\">Esplendor Maravilhoso</span></b>.",
      "level": 1
    },
    {
      "id": "pathetique_of_pateticheskaya",
      "name": "Elegia da Sinceridade Escarlate",
      "description": "Com base no ATQ de Odette que ultrapassar 1.000, cada 100 de ATQ fazem o Dano de Brilho Estelar de Odette causar mais 1.5% de Dano adicional original. É possível causar até 30% de Dano adicional original dessa forma.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_dance_of_aurore",
      "name": "Bênção das Estrelas: Dança da Manhã Prateada",
      "description": "Quando estiver dentro do <b><span style=\"color:#FFD780FF\">Campo da Estrela Polar</span></b>/nos 8s após o personagem próximo da equipe desencadear Redemoinho Estelar, Odette entrará nos estados <span style=\"color:#FFD780FF\">Brilho Reluzente: Supercondutor Estelar</span>/<span style=\"color:#FFD780FF\">Brilho Reluzente: Redemoinho Estelar</span> respectivamente.<br/>Quando um personagem desencadear Supercondutor/Redemoinho Cryo, converterá para desencadear Supercondutor Estelar/Redemoinho Estelar, e aumenta o Dano Básico dessa reação com base no ATQ de Odette: cada 100 de ATQ aumenta o Dano Básico em 0.7%. É possível acumular até 14% dessa forma.",
      "level": 0
    },
    {
      "id": "echo_of_winter_daydreams",
      "name": "Eco de um Sonho de Inverno",
      "description": "Mostra a localização de <span style=\"color:#FFD780FF\">Especialidades de Snezhnaya</span> próximas no mapa.<br/>Ao praticar sua dança no tempo livre, talvez possa ter algum outro efeito...",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1501,
      "id": "on_this_danceless_morn_she_gazes_at_her_reflection",
      "name": "\"Nessa Manhã sem Dança, Ela Olha para sua Sombra\"",
      "description": "Ao lançar a Habilidade Elemental <b><span style=\"color:#FFD780FF\">Dança Lenta: Final da Alvorada</span></b>, quando a valsa acabar, Odette causa uma instância adicional de <span style=\"color:#99FFFFFF\">Dano Cryo em AdE</span> contra os inimigos próximos. Esse Dano é considerado:<br/>· <span style=\"color:#FFD780FF\">Brilho Reluzente: Supercondutor Estelar</span> ou não está em Brilho Reluzente: causa 300% do ATQ de Odette como Dano de Supercondutor Estelar.<br/>· <span style=\"color:#FFD780FF\">Brilho Reluzente: Redemoinho Estelar</span>: causa 450% do ATQ de Odette como Dano de Redemoinho Estelar.<br/><br/>Além disso, o Talento de Ascensão \"Primavera do Escolhido\" é fortalecido: ao invocar <b><span style=\"color:#FFD780FF\">Sombra Dançarina</span></b>, Odette obtém 2 acúmulos adicionais de <b><span style=\"color:#FFD780FF\">Esplendor Maravilhoso</span></b>, e quando Odette não for a personagem ativa, a velocidade de remoção de <span style=\"color:#FFD780FF\">Esplendor Maravilhoso</span> é aumentada para 2 acúmulos por segundo.",
      "level": 1
    },
    {
      "_id": 1502,
      "id": "i_must_see_the_snow_swans_unseen_dream_for_myself_she_thought",
      "name": "\"Devo Ver o Sonho do Cisne da Neve, Pensou Ela\"",
      "description": "O Talento de Ascensão \"Primavera do Escolhido\" é fortalecido: cada acúmulo de <b><span style=\"color:#FFD780FF\">Esplendor Maravilhoso</span></b> aumenta o ATQ do personagem em 7%.<br/>Além disso, quando <b><span style=\"color:#FFD780FF\">Sombra Dançarina</span></b> está em campo, se Odette estiver no estado <b><span style=\"color:#FFD780FF\">Brilho Reluzente: Brilho Estelar</span></b>, a <span style=\"color:#FFD780FF\">Sombra Dançarina</span> reduzirá a RES Elemental correspondente dos inimigos próximos em 20%.<br/>· <span style=\"color:#FFD780FF\">Brilho Reluzente: Supercondutor Estelar</span>: <span style=\"color:#99FFFFFF\">Cryo</span>, <span style=\"color:#FFACFFFF\">Electro</span>.<br/>· <span style=\"color:#FFD780FF\">Brilho Reluzente: Redemoinho Estelar</span>: <span style=\"color:#99FFFFFF\">Cryo</span>, <span style=\"color:#80FFD7FF\">Anemo</span>.",
      "level": 2
    },
    {
      "_id": 1503,
      "id": "ill_chase_the_shouting_wind_along_climbing_alone_as_i_go",
      "name": "\"Preciso Seguir o Vento Uivante e Continuar Avançando por Conta Própria\"",
      "description": "Aumenta o nível da Habilidade Elemental <color=#FFD780FF><b>Dança Lenta: Transe da Noite Fantasma</b></color> em 3 níveis. <br/>O nível máximo de elevação é 15.",
      "level": 3
    },
    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "\"Para Cima, Enquanto Caio no Céu Enevoado e Ardente\"",
      "description": "O Supremo <span style=\"color:#FFD780FF\">Dança Rápida: Sonho de Penas Escuras</span> é fortalecido: quando Odette obter <span style=\"color:#FFD780FF\">Sonho do Cisne da Neve</span>, aumentará o Dano de Brilho Estelar dos outros personagens próximos. O aumento é de 50% do efeito <span style=\"color:#FFD780FF\">Sonho do Cisne da Neve</span>.<br/><br/>Além disso, quando um personagem da equipe causar Dano de Brilho Estelar contra um inimigo, Odette faz um Ataque Coordenado contra o inimigo, causando <span style=\"color:#99FFFFFF\">Dano Cryo em AdE</span> uma vez. Esse efeito pode ser desencadeado uma vez a cada 3.5s, e o Dano é considerado de: <br/>· Quando está em <span style=\"color:#FFD780FF\">Brilho Reluzente: Supercondutor Estelar</span> ou não está em Brilho Reluzente: 66% do ATQ de Odette como Dano de Supercondutor Estelar.<br/>· <span style=\"color:#FFD780FF\">Brilho Reluzente: Redemoinho Estelar</span>: 99% do ATQ de Odette como Dano de Redemoinho Estelar.",
      "level": 4
    },
    {
      "_id": 1505,
      "id": "oh_i_have_slipped_the_surly_bonds_of_earth",
      "name": "\"Veja, Me Despedi do Sofrimento Terreno\"",
      "description": "Aumenta o nível de <color=#FFD780FF><b>Dança Rápida: Sonho de Penas Escuras</b></color> em 3.<br/>O nível máximo de elevação é 15.",
      "level": 5
    },
    {
      "_id": 1506,
      "id": "put_out_my_hand_and_touched_the_face_of_the_divine",
      "name": "\"Estenda sua Mão para Tocar o Céu\"",
      "description": "O Talento de Ascensão \"Primavera do Escolhido\" é fortalecido: quando Odette conceder <b><span style=\"color:#FFD780FF\">Esplendor Maravilhoso</span></b> para todos os membros da equipe próximos, seu Esplendor Maravilhoso não será reduzido.<br/>Além disso, personagens sob efeito de <span style=\"color:#FFD780FF\">Esplendor Maravilhoso</span> têm seu Dano de Brilho Estelar causado contra inimigos <b><span style=\"color:#FFD780FF\">Elevado</span></b> em 25%, e Eleva o Dano de Brilho Estelar causado contra os inimigos por Odette em 20% adicionais.",
      "level": 6
    }
