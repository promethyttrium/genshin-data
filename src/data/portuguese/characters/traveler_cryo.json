  "passives": [
    {
      "id": "everkeen_frost",
      "name": "Gelo Eternamente Afiado",
      "description": "<span style=\"color:#FFD780FF\">Brilho Reluzente: Supercondutor Estelar</span>: na duração de <span style=\"color:#FFD780FF\">Estrela do Gelo Feroz</span>, o Ataque Normal, Carregado e Imersivo do Viajante serão convertidos para <span style=\"color:#99FFFFFF\">Dano Cryo</span> que não pode ser substituído, e aumenta o Dano causado em 80% do ATQ do Viajante.",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "Gelo Translúcido",
      "description": "Aumenta a Proficiência Elemental do Viajante em 8% de seu ATQ. É possível aumentar sua Proficiência Elemental em até 160 dessa forma.",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "Bênção das Estrelas: Espelho Ilusório Gelado",
      "description": "Quando estiver dentro de um <b><span style=\"color:#FFD780FF\">Campo da Estrela Polar</span></b> nos 8s após um personagem próximo da equipe desencadear Redemoinho Estelar, o Viajante entrará respectivamente nos estados <span style=\"color:#FFD780FF\">Brilho Reluzente: Supercondutor Estelar</span>/<span style=\"color:#FFD780FF\">Brilho Reluzente: Redemoinho Estelar</span>.<br/>Quando um personagem desencadear Supercondutor/Redemoinho Cryo, converterá para desencadear Supercondutor Estelar/Redemoinho Estelar, e aumenta o Dano Básico dessa reação com base no ATQ do Viajante: cada 100 de ATQ aumenta o Dano Básico em 0.35%. É possível acumular até 7% dessa forma.",
      "level": 0
    }
  ],
