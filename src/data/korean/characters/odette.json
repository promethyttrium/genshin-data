  "passives": [
    {
      "id": "spring_rite_of_the_chosen_one",
      "name": "봄의 제전",
      "description": "오데트가 <b><span style=\"color:#FFD780FF\">눈 그림자</span></b> 소환 시, 추가로 <b><span style=\"color:#FFD780FF\">광채</span></b> 4스택을 획득한다",
      "level": 1
    },
    {
      "id": "pathetique_of_pateticheskaya",
      "name": "진실의 애가",
      "description": "오데트의 공격력이 1000pt를 초과할 경우, 초과한 공격력 100pt마다 오데트가 주는 별빛 반응 피해에 기존 피해의 1.5%에 해당하는 추가 피해를 준다. 해당 방식으로 최대 기존의 30%에 해당하는 추가 피해를 준다",
      "level": 4
    },
    {
      "id": "stellar_jubilee_dance_of_aurore",
      "name": "별빛 축복·춤추는 은빛 여명",
      "description": "<b><span style=\"color:#FFD780FF\">극지의 별영역</span></b> 내에 있을 때/파티 내 캐릭터가 주변에 별 확산 반응 발동 후 8초 동안, 오데트는 각각 <span style=\"color:#FFD780FF\">섬광·별 초전도</span>/<span style=\"color:#FFD780FF\">섬광·별 확산</span> 상태에 진입한다.<br/>파티 내 캐릭터가 초전도/얼음 원소 확산 반응 발동 시, 별 초전도/별 확산 반응 발동으로 전환되며, 오데트의 공격력에 기반하여 파티 내 캐릭터가 주는 상술한 반응의 기본 피해가 증가한다: 공격력 100pt당 상술한 반응의 기본 피해가 0.7% 증가하며, 해당 방식으로 최대 14% 증가한다",
      "level": 0
    },
    {
      "id": "echo_of_winter_daydreams",
      "name": "겨울꿈의 메아리",
