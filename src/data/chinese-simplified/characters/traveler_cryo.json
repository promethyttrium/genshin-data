  "passives": [
    {
      "id": "everkeen_frost",
      "name": "自锐的凛冰",
      "description": "<span style=\"color:#FFD780FF\">辉映·星超导</span>：<span style=\"color:#FFD780FF\">栗烈寒星</span>存在期间，旅行者的普通攻击、重击、下落攻击将转为造成无法被附魔覆盖的<span style=\"color:#99FFFFFF\">冰元素伤害</span>，且造成的伤害提升，提升值相当于旅行者攻击力的80%。",
      "level": 1
    },
    {
      "id": "lucent_ice",
      "name": "通明的冽冰",
      "description": "旅行者的元素精通提升，提升值相当于旅行者攻击力的8%。通过这种方式，至多使旅行者的元素精通提升160点。",
      "level": 4
    },
    {
      "id": "stellar_jubilee_illusory_frostmirror",
      "name": "星耀祝礼·幻变冰镜",
      "description": "处于<b><span style=\"color:#FFD780FF\">极星辉域</span></b>中时/队伍中的角色在附近触发星扩散反应后的8秒内，旅行者将分别进入<span style=\"color:#FFD780FF\">辉映·星超导</span>/<span style=\"color:#FFD780FF\">辉映·星扩散</span>状态。<br/>队伍中的角色触发超导/冰元素扩散反应时，将转为触发星超导/星扩散反应，且基于旅行者的攻击力，提升队伍中角色造成的上述反应的基础伤害：每100点攻击力都将提升0.35%上述反应的基础伤害，至多通过这种方式提升7%伤害。",
      "level": 0
    }
  ],
