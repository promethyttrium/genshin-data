  "passives": [
    {
      "id": "spring_rite_of_the_chosen_one",
      "name": "获选者的春祭",
      "description": "奥黛塔召唤<b><span style=\"color:#FFD780FF\">独舞倒影</span></b>时，还会获得4层<b><span style=\"color:#FFD780FF\">华彩</span></b>。",
      "level": 1
    },
    {
      "id": "pathetique_of_pateticheskaya",
      "name": "赤忱者的悲歌",
      "description": "基于奥黛塔攻击力超过1000点的部分，每100点攻击力都将使奥黛塔造成的星烁反应伤害额外造成原本1.5%的伤害，至多通过这种方式额外造成原本30%的伤害。",
      "level": 4
    },
    {
      "id": "stellar_jubilee_dance_of_aurore",
      "name": "星耀祝礼·银晓之舞",
      "description": "处于<b><span style=\"color:#FFD780FF\">极星辉域</span></b>中时/队伍中的角色在附近触发星扩散反应后的8秒内，奥黛塔将分别进入<span style=\"color:#FFD780FF\">辉映·星超导</span>/<span style=\"color:#FFD780FF\">辉映·星扩散</span>状态。<br/>队伍中的角色触发超导/冰元素扩散反应时，将转为触发星超导/星扩散反应，且基于奥黛塔的攻击力，提升队伍中角色造成的上述反应的基础伤害：每100点攻击力都将提升0.7%上述反应的基础伤害，至多通过这种方式提升14%伤害。",
      "level": 0
    },
    {
      "id": "echo_of_winter_daydreams",
      "name": "回响中的冬梦",
      "description": "在小地图上显示周围的<span style=\"color:#FFD780FF\">至冬区域特产</span>的位置。<br/>在闲暇时练习舞蹈，或许还会触发其他的效果…",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1501,
      "id": "on_this_danceless_morn_she_gazes_at_her_reflection",
      "name": "「不曾起舞的清晨，她望向倒影」",
      "description": "施放特殊元素战技<b><span style=\"color:#FFD780FF\">柔板·破晓终奏</span></b>后，在共舞结束时，奥黛塔将对附近的敌人造成一次额外的<span style=\"color:#99FFFFFF\">冰元素范围伤害</span>，该伤害视为：<br/>·<span style=\"color:#FFD780FF\">辉映·星超导</span>或不处于辉映状态：相当于奥黛塔攻击力300%的星超导反应伤害；<br/>·<span style=\"color:#FFD780FF\">辉映·星扩散</span>：相当于奥黛塔攻击力450%的星扩散反应伤害。<br/><br/>此外，突破天赋「获选者的春祭」获得强化：召唤<b><span style=\"color:#FFD780FF\">独舞倒影</span></b>时，奥黛塔将额外获得2层<b><span style=\"color:#FFD780FF\">华彩</span></b>，且奥黛塔处于队伍后台时，清除<span style=\"color:#FFD780FF\">华彩</span>的速度提升至每秒2层。",
      "level": 1
    },
    {
      "_id": 1502,
      "id": "i_must_see_the_snow_swans_unseen_dream_for_myself_she_thought",
      "name": "「她想，我要见证雪鹄未见之梦」",
      "description": "突破天赋「获选者的春祭」获得强化：每层<b><span style=\"color:#FFD780FF\">华彩</span></b>还会使角色的攻击力提升7%。<br/>此外，<b><span style=\"color:#FFD780FF\">独舞倒影</span></b>在场时，若奥黛塔处于<b><span style=\"color:#FFD780FF\">辉映·星烁</span></b>状态，<span style=\"color:#FFD780FF\">独舞倒影</span>附近敌人的对应元素抗性还会降低20%：<br/>·<span style=\"color:#FFD780FF\">辉映·星超导</span>：<span style=\"color:#99FFFFFF\">冰元素</span>、<span style=\"color:#FFACFFFF\">雷元素</span>；<br/>·<span style=\"color:#FFD780FF\">辉映·星扩散</span>：<span style=\"color:#99FFFFFF\">冰元素</span>、<span style=\"color:#80FFD7FF\">风元素</span>。",
      "level": 2
    },
    {
      "_id": 1503,
      "id": "ill_chase_the_shouting_wind_along_climbing_alone_as_i_go",
      "name": "「我要追逐呼啸的风，向上独行」",
      "description": "元素战技<color=#FFD780FF><b>柔板·幻灵夜舞</b></color>的技能等级提高3级。<br/>至多提升至15级。",
      "level": 3
    },
    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "「向上，坠往恍惚、燃烧的蓝空」",
      "description": "元素爆发<span style=\"color:#FFD780FF\">疾板·苍羽一梦</span>获得强化：奥黛塔获得<span style=\"color:#FFD780FF\">雪鹄之梦</span>时，还会使队伍中附近的其他角色造成的星烁反应伤害提升，提升值相当于<span style=\"color:#FFD780FF\">雪鹄之梦</span>效果的50%。<br/><br/>此外，队伍中的角色对敌人造成星烁反应伤害时，奥黛塔还会对敌人进行一次协同攻击，造成一次<span style=\"color:#99FFFFFF\">冰元素范围伤害</span>，每3.5秒至多触发一次，该伤害视为：<br/>·<span style=\"color:#FFD780FF\">辉映·星超导</span>或不处于辉映状态：相当于奥黛塔攻击力66%的星超导反应伤害；<br/>·<span style=\"color:#FFD780FF\">辉映·星扩散</span>：相当于奥黛塔攻击力99%的星扩散反应伤害。",
      "level": 4
    },
    {
      "_id": 1505,
      "id": "oh_i_have_slipped_the_surly_bonds_of_earth",
      "name": "「看呀，我已告别尘与土的苦痛」",
      "description": "元素爆发<color=#FFD780FF><b>疾板·苍羽一梦</b></color>的技能等级提高3级。<br/>至多提升至15级。",
      "level": 5
    },
    {
      "_id": 1506,
      "id": "put_out_my_hand_and_touched_the_face_of_the_divine",
      "name": "「伸出手，触及苍穹永恒的面容」",
      "description": "突破天赋「获选者的春祭」获得强化：奥黛塔赋予队伍中附近的所有角色<b><span style=\"color:#FFD780FF\">华彩</span></b>时，自己的华彩不再会减少。<br/>此外，处于<span style=\"color:#FFD780FF\">华彩</span>影响下的角色，对敌人造成的星烁反应伤害<b><span style=\"color:#FFD780FF\">擢升</span></b>25%，且奥黛塔对敌人造成的星烁反应伤害额外擢升20%。",
      "level": 6
    }
